# Servidor / Dashboard
PORT=2032
AUTH_TOKEN=coloque_um_token_forte_aqui

# Webhooks (n8n)
WEBHOOK_CONTAS_URL=https://seu-n8n/webhook/contas_contratos
WEBHOOK_ENVIO_URL=https://seu-n8n/webhook/contas

# Credenciais padrão (fallback, se o webhook não enviar email/senha)
EMAIL_DEFAULT=usuario@exemplo.com
SENHA_DEFAULT=sua_senha_aqui

# Intervalo de verificação (em horas)
CHECK_INTERVAL_HOURS=24

# Dashboard
DASHBOARD_MAX_LOG_LINES=100

# Playwright
PLAYWRIGHT_HEADLESS=false

# Logs
LOG_LEVEL=info

